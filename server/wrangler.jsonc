{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuelish",
  "main": "src/index.ts",
  "account_id": "d559eef7d175e4069c592f3ee26b14c7",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // One Worker serves the API (/api/*) and the static web app (../web).
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fuelish",
      "database_id": "8603f0bf-bf97-4b09-ad1e-369af287d3d6",
      "migrations_dir": "migrations"
    }
  ],
  // Public value (it's in every page that shows the Google button): the "Fuelish web" OAuth client.
  "vars": {
    "GOOGLE_CLIENT_ID": "1033825280710-td79ais1l0e1bq8m1sq9a5uf6ccvfmfo.apps.googleusercontent.com"
  },
  "r2_buckets": [
    { "binding": "RECORDINGS", "bucket_name": "fuelish-recordings" }
  ]
  // Secrets (set with `wrangler secret put`): DEVICE_TOKEN, WEB_TOKEN
}
