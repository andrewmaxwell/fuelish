{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuelish",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // One Worker serves the API (/api/*) and the static web app (../web).
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fuelish",
      // Replace with the id printed by `wrangler d1 create fuelish`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "RECORDINGS", "bucket_name": "fuelish-recordings" }
  ]
  // Secrets (set with `wrangler secret put`): DEVICE_TOKEN, WEB_TOKEN
}
